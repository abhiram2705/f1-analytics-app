# Copy this file to .env and fill in your values
# SQL Server connection — adjust server name as needed
# For SQL Server Express: SERVER=localhost\SQLEXPRESS
# For full SQL Server: SERVER=localhost
DATABASE_URL=mssql+pyodbc://SERVER/f1_analytics?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# FastF1 cache directory (local disk cache for downloaded session data)
FF1_CACHE_DIR=./ff1_cache

# CORS — set to your frontend URL
CORS_ORIGIN=http://localhost:5173
